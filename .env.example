# ============================================================================
# Bullseye — local development env template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# --- Desktop app -------------------------------------------------------------
# These get baked into the PyInstaller bundle (anon key is safe to ship;
# service role key is NOT — that's only used server-side in Edge Functions).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SENTRY_DSN=https://your-sentry-dsn

# --- Cloud (Supabase Edge Functions) ----------------------------------------
# Set via `supabase secrets set KEY=value`. Never bundled into the desktop app.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
EBAY_APP_ID=your-ebay-app-id
EBAY_CERT_ID=your-ebay-cert-id
EBAY_GLOBAL_ID=EBAY-ENCA
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=alerts@bullseye.app
RESEND_REPLY_TO=hello@bullseye.app

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# --- Google OAuth ------------------------------------------------------------
# Set in Supabase Auth dashboard, not here. Listed for reference.
# GOOGLE_OAUTH_CLIENT_ID=...
# GOOGLE_OAUTH_CLIENT_SECRET=...

# --- Landing page ------------------------------------------------------------
PLAUSIBLE_DOMAIN=bullseye.app
