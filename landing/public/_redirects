# Cloudflare Pages redirects.
# Format: <from>  <to>  <status>
# Status 301 = permanent (cached by browsers); 302 = temporary; 200 = rewrite.
# Reference: https://developers.cloudflare.com/pages/configuration/redirects/

# Marketing aliases
/install         /download                301
/get             /download                301
/buy             /pricing                 301
/start           /pricing                 301
/trial           /pricing                 301

# Logged-out users hitting the (future) dashboard get bounced to upgrade
/dashboard       /pricing                 302
/dashboard/*     /pricing                 302

# Common typos for legal pages
/tos             /terms                   301
/legal           /terms                   301
/policy          /privacy                 301

# Real 404 — Cloudflare Pages serves /404.html for unknown paths
# automatically. Removed the previous "/* / 302" rewrite per the
# 2026-05-06 ship-readiness review (it silently bounced unknown URLs
# to home, hurting SEO + confusing users).
