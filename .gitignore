# Secrets
.env
.env.local
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/

# Build artifacts
desktop/build/dist/
desktop/build/Output/
desktop/build/*.spec.bak
*.exe
*.msi

# But DO commit the published installer that the website serves.
# This is the user-facing download at getbullseye.app/Bullseye-Setup.exe
# served directly by GitHub Pages so the URL bar never leaves the brand.
!landing/public/Bullseye-Setup.exe

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Local data
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# Supabase CLI local state (created when you run `supabase link`)
cloud/supabase/.temp/
cloud/supabase/.branches/
cloud/supabase/.env

# In case the CLI gets run from the wrong directory and creates a
# nested project — guard against accidental commit of the duplicate.
cloud/supabase/supabase/
